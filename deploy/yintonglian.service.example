[Unit]
Description=Yintonglian Go showcase
After=network.target
[Service]
Type=simple
User=yintonglian
Group=yintonglian
WorkingDirectory=/opt/yintonglian
ExecStart=/opt/yintonglian/bin/yintonglian serve --config /opt/yintonglian/deploy/config.production.json
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
