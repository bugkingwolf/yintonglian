[Unit]
Description=Yintonglian Go showcase
After=network.target
[Service]
Type=simple
User=yintonglian
Group=yintonglian
WorkingDirectory=/opt/yintonglian
ExecStart=/opt/yintonglian/bin/yintonglian serve --root /opt/yintonglian
Environment=APP_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4317
Environment=APP_ORIGIN=https://showcase.example.com
Environment=DATA_DIR=/var/lib/yintonglian
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
