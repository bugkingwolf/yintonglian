.hero{position:relative;margin-top:28rpx;overflow:hidden;border-radius:6rpx}.hero-image{width:100%;height:380rpx}.hero-caption{position:absolute;bottom:0;left:0;right:0;padding:50rpx 25rpx 22rpx;color:white;background:linear-gradient(transparent,rgba(0,0,0,.75))}.hero-title{font-size:37rpx;font-weight:600}.hero-meta{font-size:21rpx}.hero-link{position:absolute;right:24rpx;bottom:24rpx;border:1rpx solid #ffffff80;padding:7rpx 13rpx;border-radius:4rpx;font-size:21rpx}.category-entry{padding:24rpx;background:white;display:flex;align-items:center;justify-content:space-between;border:1rpx solid #e6e1d7;border-radius:6rpx;margin-bottom:16rpx;gap:15rpx}.category-entry .card-title{font-size:31rpx;margin-bottom:5rpx}.category-entry .muted{font-size:21rpx}.category-entry .link{white-space:nowrap;font-size:21rpx}.platform-short{flex:1;padding:20rpx 12rpx;border:1rpx solid #e6e1d7;background:white;border-radius:4rpx;color:#9a712d;font-size:25rpx}.platform-short .muted{font-size:19rpx;margin-top:7rpx}
