<view class="page"><view wx:if="{{loading}}" class="loading">正在打开作品展厅…</view><view wx:elif="{{error}}" class="error">{{error}}<button class="button secondary" bindtap="load">重新加载</button></view><block wx:else><view class="brand"><view class="brand-en">{{config.company.english}}</view><view class="brand-cn">{{config.company.name}}</view></view><view class="eyebrow">MEDIA BANK · SINCE {{config.company.founded}}</view><view class="title">{{config.company.headline}}</view><view class="subtitle">品牌营销 · 内容创作 · 数字互动</view><view wx:if="{{hero}}" class="hero" data-id="{{hero.id}}" bindtap="openCase"><image src="{{hero.cover}}" mode="aspectFill" class="hero-image"/><view class="hero-caption"><view class="hero-title">{{hero.title}}</view><view class="hero-meta">{{hero.clientName}} · {{hero.typeName}}</view><view class="hero-link">查看案例 →</view></view></view><view class="section-head"><view class="section-title">业务与案例</view><view class="link" bindtap="allCases">全部案例 →</view></view><view wx:for="{{config.categories}}" wx:key="id" class="category-entry" data-id="{{item.id}}" bindtap="openCategory"><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.subtitle}}</view></view><view class="link">查看案例 →</view></view><view class="section-head"><view class="section-title">精选案例</view><view class="link" bindtap="allCases">查看全部 →</view></view><view class="case-grid"><view wx:for="{{featured}}" wx:key="id" class="case" data-id="{{item.id}}" bindtap="openCase"><image class="case-cover" src="{{item.cover}}" mode="aspectFill"/><view class="case-title">{{item.title}}</view><view class="case-meta">{{item.clientName}} / {{item.typeName}}</view></view></view><view class="section-head"><view class="section-title">平台入口</view><view class="link" bindtap="openPlatforms">查看使用方式 →</view></view><view class="row"><view wx:for="{{config.platforms}}" wx:key="id" class="platform-short" bindtap="openPlatforms"><view>{{item.name}} →</view><view class="muted">{{item.subtitle}}</view></view></view><view class="divider"/><view class="subtitle">{{config.company.philosophy}}</view><view class="link" style="margin-top:24rpx" bindtap="openAbout">了解银通联 →</view></block></view>
