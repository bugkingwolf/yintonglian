<view class="page"><view wx:if="loading" class="loading">正在加载…</view><view wx:elif="error" class="error">{{error}}<button class="button secondary" bindtap="load">重试</button></view><block wx:else><view class="eyebrow">PLATFORM ENTRANCE</view><view class="title">平台入口</view><view class="subtitle">进入现有平台，使用相关服务。</view><view wx:for="{{config.platforms}}" wx:key="id" class="card platform"><view class="platform-symbol">{{item.id==='geo'?'GEO':'漫剧'}}</view><view class="section-title">{{item.name}}</view><view class="subtitle">{{item.description}}</view><button class="button" style="margin-top:30rpx" data-id="{{item.id}}" bindtap="open">{{item.url?'复制平台链接 →':'咨询平台使用方式 →'}}</button><view class="small-note">{{item.url?'需使用原平台账号登录，建议电脑端使用。':'入口待配置，可先联系公司了解。'}}</view></view><view class="notice">手机适配与账号开通方式确认后，再完善相应使用入口。</view><button class="button secondary" bindtap="contact">联系协助</button></block></view>
