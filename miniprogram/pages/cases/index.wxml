<view class="page"><view wx:if="{{loading}}" class="loading">正在加载案例…</view><view wx:elif="{{error}}" class="error">{{error}}<button class="button secondary" bindtap="load">重试</button></view><block wx:else><view class="eyebrow">BUSINESS &amp; CASES</view><view class="title">业务与案例</view><view class="subtitle">了解服务，查看项目成果。</view><block wx:if="{{overview}}"><view wx:for="{{config.categories}}" wx:key="id" class="card" style="margin-top:24rpx" data-id="{{item.id}}" bindtap="category"><view class="card-title">{{item.name}}</view><view class="section-copy">{{item.description}}</view><view style="margin:15rpx 0"><text wx:for="{{item.services}}" wx:for-item="service" wx:key="*this" class="tag">{{service}}</text></view><view class="link">查看案例 →</view></view><view class="section-head"><view class="section-title">按客户看案例</view></view><view class="chips"><view wx:for="{{config.clients}}" wx:key="id" class="chip" data-id="{{item.id}}" bindtap="client">{{item.name}} →</view></view><button class="button secondary" bindtap="all" style="margin-top:35rpx">查看全部案例 →</button></block><block wx:else><view class="section-head"><view class="card-title">{{selectedTitle}}</view><view class="link" bindtap="reset">返回业务总览</view></view><view class="chips"><view wx:for="{{types}}" wx:key="id" class="chip {{type===item.id?'active':''}}" data-id="{{item.id}}" bindtap="changeType">{{item.name}}</view></view><view class="filters"><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="changeCategory"><view class="picker">{{categories[categoryIndex].name}} ▾</view></picker><picker range="{{clients}}" range-key="name" value="{{clientIndex}}" bindchange="changeClient"><view class="picker">{{clients[clientIndex].name}} ▾</view></picker></view><input class="search" placeholder="搜索案例名称" value="{{query}}" bindconfirm="search" confirm-type="search"/><view class="small-note">{{items.length}} 个案例</view><view class="case-grid"><view wx:for="{{items}}" wx:key="id" class="case" data-id="{{item.id}}" bindtap="openCase"><image src="{{item.cover}}" class="case-cover" mode="aspectFill"/><view class="case-title">{{item.title}}</view><view class="case-meta">{{item.clientName}} / {{item.typeName}}</view><view class="link" style="font-size:21rpx;margin-top:8rpx">查看详情 →</view></view></view><view wx:if="{{!items.length}}" class="empty">暂无符合条件的案例，请调整筛选条件。</view></block></block></view>
