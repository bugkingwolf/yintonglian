<view class="page"><view wx:if="{{loading}}" class="loading">正在打开案例…</view><view wx:elif="{{error}}" class="error">{{error}}<button class="button secondary" bindtap="load">重试</button></view><block wx:else><video wx:if="{{item.video}}" class="video" src="{{item.video}}" poster="{{item.cover}}" controls/><image wx:else class="detail-cover" src="{{item.cover}}" mode="aspectFill" data-url="{{item.cover}}" bindtap="preview"/><view wx:if="{{item.type==='video' && !item.video}}" class="notice">当前展示案例画面，原视频上传后可在线播放。</view><view class="eyebrow" style="margin-top:30rpx">{{item.typeName}}</view><view class="title">{{item.title}}</view><view class="subtitle">{{item.summary}}</view><view class="nav-row row" bindtap="client"><text class="muted">项目客户</text><text>{{item.clientName}} →</text></view><view class="nav-row row" bindtap="category"><text class="muted">所属业务</text><text>{{item.categoryName}} →</text></view><view style="margin:22rpx 0"><text wx:for="{{item.services}}" wx:key="*this" class="tag">{{item}}</text></view><view class="row"><button class="button" bindtap="contact">咨询合作</button><button class="button secondary" open-type="share">分享案例</button></view><button wx:if="{{item.experienceUrl}}" class="button secondary" bindtap="experience" style="margin-top:20rpx">体验H5项目 →</button><view wx:elif="{{item.type==='h5'}}" class="notice">当前展示项目截图，体验链接待补充。</view><view class="section-head"><view class="section-title">项目介绍</view></view><view class="section-copy">{{item.description}}</view><view wx:if="{{item.gallery.length}}" class="section-head"><view class="section-title">项目画面</view></view><image wx:for="{{item.gallery}}" wx:for-item="src" wx:key="*this" src="{{src}}" mode="widthFix" class="project-image" data-url="{{src}}" bindtap="preview"/><view wx:if="{{related.length}}" class="section-head"><view class="section-title">相关案例</view></view><view class="case-grid"><view wx:for="{{related}}" wx:key="id" class="case" data-id="{{item.id}}" bindtap="openRelated"><image class="case-cover" src="{{item.cover}}" mode="aspectFill"/><view class="case-title">{{item.title}}</view><view class="case-meta">{{item.clientName}}</view></view></view></block></view>
