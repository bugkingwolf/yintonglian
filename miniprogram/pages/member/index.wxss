.member-page{padding-bottom:160rpx}.member-hero{margin-top:24rpx;background:#fff;border:1rpx solid #e8dfcf;overflow:hidden}.member-portrait,.portrait-placeholder{width:100%;height:520rpx;background:#eee9df}.portrait-placeholder{display:flex;align-items:center;justify-content:center;color:#9a712d;font-size:50rpx}.member-heading{padding:36rpx}.member-role{color:#9a712d;font-size:25rpx}.member-name{font-size:60rpx;margin:10rpx 0 16rpx}.member-company{color:#777;font-size:25rpx}.member-bio{white-space:pre-line;font-size:28rpx;line-height:1.9;margin:32rpx 0}.contact-block .button{margin-top:18rpx;white-space:normal;overflow-wrap:anywhere}.qr-block{text-align:center;margin-top:30rpx}.qr-block image{width:300rpx;height:300rpx}.member-actions{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));display:flex;gap:18rpx;background:#fff;border-top:1rpx solid #e8dfcf}.member-actions .button{flex:1;font-size:27rpx;margin:0}
.member-hero{display:grid;grid-template-columns:230rpx minmax(0,1fr)}.member-portrait,.portrait-placeholder{height:300rpx;width:230rpx}.member-heading{padding:30rpx 24rpx;align-self:center}.member-name{font-size:48rpx}.member-company{font-size:23rpx;line-height:1.6}.member-role{font-size:24rpx}

.share-cover-canvas{position:fixed;left:-2000px;top:0;width:600px;height:480px;pointer-events:none}
