<view class="page member-page"><view wx:if="{{loading}}" class="loading">正在打开名片…</view><view wx:elif="{{error}}" class="error">{{error}}<button class="button secondary" bindtap="load">重新加载</button></view><block wx:else><view class="eyebrow">{{company.english}} · 电子名片</view><view class="member-hero"><image wx:if="{{member.photo}}" src="{{member.photo}}" mode="aspectFill" class="member-portrait"/><view wx:else class="portrait-placeholder">{{member.name}}</view><view class="member-heading"><view class="member-role">{{member.role}}</view><view class="member-name">{{member.name}}</view><view class="member-company">{{company.legalName || company.name}}</view></view></view><view class="contact-block"><view class="card-title">联系我</view><button wx:if="{{member.phone}}" class="button secondary" bindtap="phone">拨打电话 · {{member.phone}}</button><button wx:if="{{member.wechat}}" class="button secondary" bindtap="copyWechat">复制微信号 · {{member.wechat}}</button><view wx:if="{{member.wechatQR}}" class="qr-block"><image src="{{member.wechatQR}}" mode="aspectFit" bindtap="previewQR"/><view class="small-note">点击查看微信二维码，保存后可在微信扫一扫中识别添加</view></view><view wx:if="{{!member.phone && !member.wechat && !member.wechatQR}}" class="small-note">个人联系方式暂未填写</view></view><view wx:if="{{member.biography}}" class="member-bio">{{member.biography}}</view><view class="member-actions"><button class="button secondary" bindtap="saveContact">保存联系人</button><button class="button" open-type="share">分享名片 →</button></view></block></view>
<canvas type="2d" id="member-share-canvas" class="share-cover-canvas" aria-hidden="true"></canvas>
