<view class="page"><view wx:if="loading" class="loading">正在加载…</view><view wx:elif="error" class="error">{{error}}<button class="button secondary" bindtap="load">重试</button></view><block wx:else><view class="brand"><view class="brand-en">{{config.company.english}}</view><view class="brand-cn">{{config.company.name}}</view></view><view class="eyebrow">SINCE {{config.company.founded}}</view><view class="title"><view>用新媒体内容</view><view>创造价值</view></view><view class="subtitle">{{config.company.slogan}}</view><view class="divider"/><view class="section-head"><view class="section-title">公司简介</view></view><view class="section-copy">{{config.company.introduction}}</view><view class="card" style="margin-top:30rpx"><view class="card-title">公司愿景</view><view class="section-copy">{{config.company.vision}}</view><view class="section-copy" style="margin-top:20rpx">{{config.company.philosophy}}</view></view><view class="card"><view class="card-title">我们的团队</view><view class="section-copy">{{config.company.team}}</view></view><view wx:if="{{management.length}}" class="section-head"><view class="section-title">管理团队</view></view><view class="people-list"><view wx:for="{{management}}" wx:key="id" class="person-card"><image wx:if="{{item.photo}}" src="{{item.photo}}" class="person-photo" mode="aspectFill"/><view class="person-info"><view class="person-role">{{item.role}}</view><view class="person-name">{{item.name}}</view><view class="person-bio">{{item.biography}}</view></view></view></view><view wx:if="{{execution.length}}" class="section-head"><view class="section-title">执行团队</view></view><view class="people-list"><view wx:for="{{execution}}" wx:key="id" class="person-card execution-person"><image wx:if="{{item.photo}}" src="{{item.photo}}" class="person-photo" mode="aspectFill"/><view class="person-info"><view class="person-role">{{item.role}}</view><view class="person-name">{{item.name}}</view><view class="person-bio">{{item.biography}}</view></view></view></view><view class="section-head"><view class="section-title">资质与荣誉</view></view><view class="section-copy">{{config.company.qualifications}}</view><image wx:for="{{config.company.qualificationImages}}" wx:key="*this" class="qualification" src="{{item}}" mode="widthFix" data-url="{{item}}" bindtap="preview"/><view class="contact-block"><view class="card-title">联系我们</view><view class="section-copy">{{config.company.phone}}</view><view class="section-copy">{{config.company.address}}</view><button class="button" bindtap="contact" style="margin-top:25rpx">咨询合作 →</button></view><view class="small-note">{{config.company.contactNote}}</view></block></view>
