.qualification{display:block;width:100%;margin:20rpx 0}.section-head{margin-top:25rpx}.title{font-size:52rpx}
.person-card{display:flex;align-items:flex-start;gap:24rpx;background:#fff;border:1rpx solid #e6e1d7;padding:24rpx;margin:20rpx 0}.person-photo{width:150rpx;height:200rpx;flex-shrink:0;background:#f4f1e9}.person-info{flex:1;min-width:0}.person-role{font-size:21rpx;color:#9a712d;line-height:1.6}.person-name{font-size:34rpx;margin:8rpx 0 14rpx;font-weight:600}.person-bio{font-size:23rpx;color:#777970;line-height:1.9;white-space:pre-line}
.execution-person .person-photo{width:112rpx;height:112rpx;border-radius:50%}

.person-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:8rpx 0 14rpx}.person-heading .person-name{margin:0;min-width:0}.person-card-link{margin:0;padding:5rpx 0 5rpx 18rpx;background:transparent;color:#9a712d;font-size:23rpx;font-weight:400;line-height:1.6;flex-shrink:0;border:0;border-radius:0}.person-card-link::after{border:0}.person-card-link text{margin-left:8rpx}.person-card-link:active{opacity:.65}
.person-heading{flex-wrap:wrap}.person-heading .person-name{flex:0 1 auto;white-space:nowrap}.person-heading .person-card-link{width:auto;min-width:0;max-width:none;display:inline-flex;align-items:center;flex:0 0 auto;box-sizing:border-box}

.company-map{display:block;width:100%;height:200px;margin-top:24rpx;border-radius:12rpx;overflow:hidden;background:#eeeae1}.map-note{margin-top:12rpx;font-size:22rpx;line-height:1.6;color:#777970}
