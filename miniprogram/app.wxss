page{background:#faf8f3;color:#292e28;font-size:28rpx;line-height:1.7;font-family:"PingFang SC","Microsoft YaHei",sans-serif}.page{padding:32rpx 36rpx 50rpx}.brand{color:#9a712d;line-height:1.3;margin-bottom:28rpx}.brand-en{font-family:Georgia,serif;letter-spacing:5rpx;font-size:20rpx}.brand-cn{font-family:"Songti SC",serif;font-size:43rpx;letter-spacing:7rpx}.eyebrow{color:#9a712d;font-size:20rpx;letter-spacing:3rpx;margin-bottom:10rpx}.title{font-family:"Songti SC",serif;font-weight:600;font-size:54rpx;line-height:1.3;margin:10rpx 0 20rpx;white-space:pre-line}.subtitle{font-size:25rpx;color:#777970;line-height:1.9}.section-title{font-family:"Songti SC",serif;font-size:39rpx;font-weight:600}.section-head{display:flex;justify-content:space-between;align-items:center;margin:42rpx 0 24rpx}.link{font-size:24rpx;color:#9a712d}.button{margin:0;background:#9a712d;color:white;border-radius:5rpx;font-size:27rpx;padding:7rpx 20rpx}.button::after{border:0}.button.secondary{background:white;color:#76511c;border:1rpx solid #e6e1d7}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.muted{color:#777970;font-size:24rpx}.tag{display:inline-block;background:#f1eadb;color:#76511c;font-size:20rpx;padding:3rpx 12rpx;margin:5rpx 8rpx 5rpx 0;border-radius:3rpx}.card{background:white;border:1rpx solid #e6e1d7;border-radius:8rpx;padding:26rpx;margin-bottom:20rpx}.card-title{font-size:32rpx;font-weight:600;margin-bottom:12rpx}.case-grid{display:flex;flex-wrap:wrap;gap:25rpx}.case{width:calc(50% - 13rpx);margin-bottom:10rpx}.case-cover{width:100%;height:245rpx;background:#eee9dc;border-radius:5rpx}.case-title{font-size:27rpx;font-weight:600;margin-top:12rpx;line-height:1.5}.case-meta{font-size:20rpx;color:#777970;margin-top:5rpx}.empty{text-align:center;color:#777970;border:1rpx dashed #e6e1d7;padding:50rpx 20rpx;margin:20rpx 0}.error{color:#8b4d38;background:#f7ece4;padding:25rpx;border-radius:5rpx;margin-bottom:20rpx}.loading{text-align:center;padding:90rpx 20rpx;color:#777970}.divider{height:1rpx;background:#e6e1d7;margin:35rpx 0}.notice{background:#f1eadb;border-left:3rpx solid #b49a63;padding:18rpx 22rpx;color:#777970;font-size:23rpx;margin:20rpx 0}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chip{padding:10rpx 20rpx;background:white;border:1rpx solid #e6e1d7;border-radius:3rpx;font-size:23rpx}.chip.active{background:#9a712d;border-color:#9a712d;color:white}.small-note{font-size:21rpx;color:#8a8d82;margin:20rpx 0}.contact-block{padding:28rpx;background:#f1eadb;margin-top:35rpx}.section-copy{font-size:26rpx;color:#777970;white-space:pre-line;line-height:1.9}.nav-row{padding:22rpx 0;border-bottom:1rpx solid #e6e1d7;font-size:26rpx}.nav-row:first-child{border-top:1rpx solid #e6e1d7}
